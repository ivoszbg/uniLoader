CONFIG_TEXT_BASE=0x60000000
CONFIG_EMBED_XNU=y
CONFIG_XNU_BLOB_LZ4=y
CONFIG_PAYLOAD_ENTRY=0x30001000
CONFIG_RAMDISK_ENTRY=0x22000000
CONFIG_RAMDISK_NO_COPY=y
CONFIG_COMPRESS_GZIP=n
CONFIG_LOGLEVEL=7
CONFIG_XNU_ENTRY_OFFSET=0xe58e0
# The shared cache is read from the SD card on this board, so do not
# spend ~154 MiB of boot.img on a copy nothing reads.
CONFIG_XNU_EMBED_CACHESLICE=n
CONFIG_XNU_PHYS_BASE=0x30000000
CONFIG_XNU_VIRT_BASE=0x80000000
CONFIG_XNU_MEMSIZE=0x25E00000
CONFIG_XNU_FB_BASE=0x57E05000
CONFIG_XNU_FB_WIDTH=480
CONFIG_XNU_FB_HEIGHT=800
CONFIG_XNU_CMDLINE="-v keepsyms=1 kprintf=1 debug=0x14e j1slot=0x2fe26624 j1uart=1 init=/sbin/launchd"
CONFIG_EXYNOS_3475=y
CONFIG_SAMSUNG_J1XLTE=y
CONFIG_EXYNOS_SDMMC3475=y
CONFIG_EXYNOS_SD_FAT=y
CONFIG_EXYNOS_SD_BOOT=y
CONFIG_EARLYCON=y
CONFIG_J1UART_MIRROR=y
